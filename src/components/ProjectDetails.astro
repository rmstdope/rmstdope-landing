---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /** The accordion already shows the name in its summary row. */
  showTitle?: boolean;
}

const { project, showTitle = true } = Astro.props;
---

<div class="details" style={`--cat: var(--cat-${project.category})`}>
  {project.screenshots.length > 0 ? (
    <div class="visual" data-slides>
      {project.screenshots.map((screenshot, index) => (
        <Image
          class="shot"
          src={screenshot}
          alt={`Screenshot ${index + 1} of ${project.screenshots.length}: ${project.id}`}
          widths={[480, 800, 1200]}
          sizes="(min-width: 960px) 520px, 100vw"
          loading="lazy"
          data-active={index === 0 ? "" : undefined}
          aria-hidden={index === 0 ? undefined : "true"}
        />
      ))}
      <span class="scan" aria-hidden="true" />
      {project.screenshots.length > 1 && (
        <div class="dots">
          {project.screenshots.map((_, index) => (
            <button
              type="button"
              aria-label={`Show screenshot ${index + 1} of ${project.screenshots.length}`}
              aria-pressed={index === 0 ? "true" : "false"}
            />
          ))}
        </div>
      )}
    </div>
  ) : (
    <div class="visual" aria-hidden="true">
      <div class="sweep" />
      <span class="feed">
        [ {project.id.toUpperCase()} · AWAITING VISUAL FEED ]
      </span>
    </div>
  )}
  {showTitle && <h3 class="title">{project.id}</h3>}
  <p class="summary">{project.summary}</p>
  <dl class="specs">
    <div>
      <dt>LANG</dt>
      <dd data-repo={project.id} data-stat="language">
        {project.language}
      </dd>
    </div>
    <div>
      <dt>STARS</dt>
      <dd data-repo={project.id} data-stat="stars">
        {project.stars}
      </dd>
    </div>
    <div>
      <dt>SINCE</dt>
      <dd>{project.since}</dd>
    </div>
    <div>
      <dt>LAST PUSH</dt>
      <dd data-repo={project.id} data-stat="pushed">
        {project.pushed}
      </dd>
    </div>
  </dl>
  <ul class="tags" aria-label="Tags">
    {project.tags.map((tag) => (
      <li>#{tag}</li>
    ))}
  </ul>
  <div class="actions">
    <a
      class="cmd"
      href={project.url}
      aria-label={`Engage on GitHub: ${project.id}`}
    >
      &gt; ENGAGE ON GITHUB ↗
    </a>
    {project.live && (
      <a
        class="cmd ghost"
        href={project.live}
        aria-label={`Live: ${project.id}`}
      >
        LIVE ↗
      </a>
    )}
  </div>
</div>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid rgb(157 255 90 / 30%);
    background-color: #060805;
    background-image:
      linear-gradient(rgb(157 255 90 / 12%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(157 255 90 / 12%) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .shot[data-active] {
    opacity: 1;
  }

  .dots {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    gap: 6px;
  }

  /* 24px hit area around a small HUD tick. */
  .dots button {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .dots button::before {
    content: "";
    display: block;
    width: 14px;
    height: 4px;
    margin: auto;
    background: rgb(157 255 90 / 35%);
    box-shadow: 0 0 0 1px rgb(7 8 6 / 70%);
  }

  .dots button[aria-pressed="true"]::before {
    background: var(--accent);
  }

  .dots button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .shot {
      transition: none;
    }
  }

  /* Faint scanlines keep screenshots in the HUD look. */
  .scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgb(7 8 6 / 18%) 0 1px,
      transparent 1px 3px
    );
    pointer-events: none;
  }

  .sweep {
    position: absolute;
    width: 140%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgb(157 255 90 / 35%),
      transparent 70deg,
      transparent 360deg
    );
    opacity: 0.6;
    animation: sweep 4s linear infinite;
  }

  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }

  .feed {
    position: relative;
    padding-inline: 12px;
    color: var(--text-dim);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-align: center;
  }

  .title {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .summary {
    margin: 0;
    color: #c3ddb6;
    font-size: 14px;
    line-height: 1.75;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .specs div {
    padding: 10px 12px;
    background: var(--bg);
  }

  .specs dt {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.18em;
  }

  .specs dd {
    margin: 4px 0 0;
    color: var(--text-strong);
    font-size: 14px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 4px 10px;
    border: 1px solid rgb(157 255 90 / 35%);
    color: #c3ddb6;
    font-size: 12px;
  }
</style>
