---
import type { Project } from "../data/projects";
import Slideshow from "./Slideshow.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="details" style={`--cat: var(--cat-${project.category})`}>
  <Slideshow project={project} />
  <h2 class="title" id={`dialog-${project.id}`}>
    {project.id}
  </h2>
  <p class="summary">{project.summary}</p>
  <dl class="specs">
    <div>
      <dt>LANG</dt>
      <dd data-repo={project.id} data-stat="language">
        {project.language}
      </dd>
    </div>
    <div>
      <dt>STARS</dt>
      <dd data-repo={project.id} data-stat="stars">
        {project.stars}
      </dd>
    </div>
    <div>
      <dt>SINCE</dt>
      <dd>{project.since}</dd>
    </div>
    <div>
      <dt>LAST PUSH</dt>
      <dd data-repo={project.id} data-stat="pushed">
        {project.pushed}
      </dd>
    </div>
  </dl>
  <ul class="tags" aria-label="Tags">
    {project.tags.map((tag) => (
      <li>#{tag}</li>
    ))}
  </ul>
  <div class="actions">
    <a
      class="cmd"
      href={project.url}
      target="_blank"
      rel="noopener"
      aria-label={`Engage on GitHub: ${project.id}`}
    >
      &gt; ENGAGE ON GITHUB ↗
    </a>
    {project.live && (
      <a
        class="cmd ghost"
        href={project.live}
        target="_blank"
        rel="noopener"
        aria-label={`Live: ${project.id}`}
      >
        LIVE ↗
      </a>
    )}
  </div>
</div>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Wide screens: large slideshow beside the facts. */
  @media (min-width: 960px) {
    .details {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 18px 32px;
      align-content: start;
    }

    .details > :global(.visual) {
      grid-row: 1 / span 6;
      align-self: start;
    }
  }

  .title {
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  .summary {
    margin: 0;
    color: #c3ddb6;
    font-size: 14px;
    line-height: 1.75;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .specs div {
    padding: 10px 12px;
    background: var(--bg);
  }

  .specs dt {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: 0.18em;
  }

  .specs dd {
    margin: 4px 0 0;
    color: var(--text-strong);
    font-size: 14px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 4px 10px;
    border: 1px solid rgb(157 255 90 / 35%);
    color: #c3ddb6;
    font-size: 12px;
  }
</style>
