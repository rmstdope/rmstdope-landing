---
import type { Project } from "../data/projects";
import ProjectDetails from "./ProjectDetails.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<dialog
  class="dialog"
  data-dialog={project.id}
  aria-labelledby={`dialog-${project.id}`}
>
  <span class="corner tl" aria-hidden="true"></span>
  <span class="corner br" aria-hidden="true"></span>
  <div class="frame">
    <div class="bar">
      <p class="lock">
        ◎ {project.code} · {project.categoryCode} DOSSIER
      </p>
      <form method="dialog">
        <button class="close">
          CLOSE <span aria-hidden="true">✕</span>
        </button>
      </form>
    </div>
    <ProjectDetails project={project} />
  </div>
</dialog>

<style>
  .dialog {
    width: min(1180px, 100vw - 32px);
    max-width: none;
    max-height: calc(100dvh - 32px);
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    color: var(--text);
  }

  .dialog::backdrop {
    background: rgb(4 6 3 / 82%);
    backdrop-filter: blur(3px);
  }

  .dialog[open] {
    animation: boot 0.25s ease-out;
  }

  @keyframes boot {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .frame {
    position: relative;
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 20px 24px 24px;
    border: 1px solid var(--accent);
    background: #0a0d08;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
  }

  .lock {
    margin: 0;
    color: var(--warn);
    font-size: 11px;
    letter-spacing: 0.18em;
  }

  form {
    margin: 0;
  }

  .close {
    min-height: 40px;
    padding: 0 12px;
    border: 1px solid rgb(157 255 90 / 35%);
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.12em;
    cursor: pointer;
  }

  .close:hover {
    background: var(--wash);
  }

  .corner {
    position: absolute;
    z-index: 1;
    width: 18px;
    height: 18px;
  }

  .corner.tl {
    top: -1px;
    left: -1px;
    border-top: 3px solid var(--warn);
    border-left: 3px solid var(--warn);
  }

  .corner.br {
    right: -1px;
    bottom: -1px;
    border-right: 3px solid var(--warn);
    border-bottom: 3px solid var(--warn);
  }

  /* Phones: the dossier takes the whole screen. */
  @media (max-width: 639px) {
    .dialog {
      width: 100vw;
      height: 100dvh;
      max-height: none;
      margin: 0;
    }

    .frame {
      height: 100%;
      max-height: none;
      padding: 16px;
    }

    .corner {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dialog[open] {
      animation: none;
    }
  }
</style>
