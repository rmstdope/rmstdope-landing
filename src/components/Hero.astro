---
import { github } from "../data/site";

// Boot log lines type out one after another: the label types one step per
// character, then the leader and status appear.
const boot = [
  { label: "load profile", status: "ok", tone: "ok" },
  { label: "emulation cores: NES GB GBC GBA SNES", status: "ok", tone: "ok" },
  { label: "agent fleet: cerebro", status: "standing by", tone: "warn" },
  { label: "heritage: Dope Demo Productions", status: "archived", tone: "ok" },
].map((line, index) => typing(`> ${line.label}`, index, line));
const prompt = typing("> awaiting operator input", boot.length, {});

function typing<T>(text: string, index: number, extra: T) {
  const delay = 0.4 + index * 0.7;
  return {
    ...extra,
    text,
    style: `--delay: ${delay}s; --chars: ${text.length}; --done: ${delay + 0.5}s`,
  };
}
---

<section id="top" class="hero">
  <div class="container layout">
    <div class="identity">
      <p class="eyebrow">▲ SYSTEMS ONLINE</p>
      <h1 class="name">
        <span>Henrik</span> <span>Kurelid</span>
      </h1>
      <div class="boot" role="log" aria-label="Boot log">
        {boot.map((line) => (
          <p class="line" style={line.style}>
            <span class="label">{line.text}</span>
            <span class="leader" aria-hidden="true" />
            <span class={line.tone}>{line.status}</span>
          </p>
        ))}
        <p class="line" style={prompt.style}>
          <span class="label">{prompt.text}</span>
          <span class="cursor" aria-hidden="true">
            █
          </span>
        </p>
      </div>
    </div>
    <div class="intro">
      <p>
        Developer in Linköping, Sweden. Demoscene roots, Rust emulators,
        play-by-email strategy tooling and fleets of AI coding agents.
      </p>
      <a class="cmd" href={github}>
        &gt; GITHUB.COM/RMSTDOPE ↗
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    background-image:
      linear-gradient(rgb(157 255 90 / 6%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(157 255 90 / 6%) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 48px;
    padding-block: clamp(48px, 8vw, 72px) clamp(56px, 8vw, 80px);
  }

  .identity {
    display: flex;
    flex: 3 1 min(600px, 100%);
    flex-direction: column;
    gap: 24px;
    min-width: 0;
  }

  .eyebrow {
    margin: 0;
    color: var(--warn);
    font-size: 13px;
    letter-spacing: 0.24em;
  }

  .name span {
    display: block;
  }

  .name {
    position: relative;
    margin: 0;
    color: var(--text-strong);
    font-family: var(--font-display);
    font-size: clamp(56px, 10vw, 112px);
    font-weight: 700;
    line-height: 0.92;
    text-transform: uppercase;
    text-shadow:
      2px 0 rgb(255 181 71 / 75%),
      -2px 0 rgb(90 220 255 / 60%);
    animation: glitch 7s steps(1) infinite 3s;
  }

  /* Brief chromatic jolts a few times per cycle. */
  @keyframes glitch {
    0%,
    100% {
      transform: none;
    }

    2% {
      transform: translateX(3px) skewX(-6deg);
      text-shadow:
        5px 0 rgb(255 181 71 / 85%),
        -4px 0 rgb(90 220 255 / 70%);
    }

    3% {
      transform: translateX(-2px);
      text-shadow:
        2px 0 rgb(255 181 71 / 75%),
        -2px 0 rgb(90 220 255 / 60%);
    }

    4% {
      transform: none;
    }

    51% {
      transform: translateX(-3px) skewX(4deg);
    }

    52% {
      transform: none;
    }
  }

  .boot {
    max-width: 640px;
    min-width: 0;
    overflow: hidden;
    padding: 20px 22px;
    border: 1px solid rgb(157 255 90 / 25%);
    background: rgb(7 8 6 / 85%);
    color: var(--text-dim);
    font-size: clamp(12px, 2.6vw, 14px);
    line-height: 1.9;
  }

  .line {
    display: flex;
    gap: 8px;
    margin: 0;
    white-space: nowrap;
    opacity: 0;
    animation: appear 0s var(--delay) forwards;
  }

  .label {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    clip-path: inset(0 100% 0 0);
    animation: type 0.5s steps(var(--chars)) var(--delay) forwards;
  }

  .leader,
  .ok,
  .warn,
  .cursor {
    opacity: 0;
    animation: appear 0s var(--done) forwards;
  }

  @keyframes appear {
    to {
      opacity: 1;
    }
  }

  @keyframes type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .leader {
    flex: 1;
    min-width: 16px;
    margin-bottom: 0.45em;
    border-bottom: 2px dotted rgb(157 255 90 / 30%);
  }

  .ok {
    color: var(--accent);
  }

  .warn {
    color: var(--warn);
  }

  .cursor {
    color: var(--accent);
    animation:
      appear 0s var(--done) forwards,
      blink 1.1s steps(1) var(--done) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .intro {
    display: flex;
    flex: 2 1 min(340px, 100%);
    flex-direction: column;
    gap: 20px;
    min-width: 0;
  }

  .intro p {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
  }

  .cmd {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 48px;
    padding: 0 22px;
    background: var(--accent);
    color: var(--bg);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .cmd:hover {
    background: var(--accent-hover);
    color: var(--bg);
  }

  @media (prefers-reduced-motion: reduce) {
    .line,
    .leader,
    .ok,
    .warn,
    .cursor {
      opacity: 1;
    }

    .label {
      clip-path: none;
    }
  }
</style>
