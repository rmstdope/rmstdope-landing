---
import { Image } from "astro:assets";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
  /** The popup shows screenshots at up to two thirds of the viewport. */
  large?: boolean;
}

const { project, large = false } = Astro.props;
const count = project.screenshots.length;
const widths = large ? [800, 1200, 1600, 2400] : [480, 800, 1200];
const sizes = large
  ? "(min-width: 960px) 62vw, 100vw"
  : "(min-width: 960px) 520px, 100vw";
---

{count > 0 ? (
  <div class="visual" data-slides>
    <div class="track">
      {project.screenshots.map((screenshot, index) => (
        <Image
          class="shot"
          src={screenshot}
          alt={`Screenshot ${index + 1} of ${count}: ${project.id}`}
          widths={widths}
          sizes={sizes}
          loading="lazy"
          data-active={index === 0 ? "" : undefined}
          aria-hidden={index === 0 ? undefined : "true"}
        />
      ))}
    </div>
    <span class="scan" aria-hidden="true" />
    {count > 1 && (
      <>
        <button
          class="step prev"
          type="button"
          aria-label="Previous screenshot"
          data-step="-1"
        >
          ‹
        </button>
        <button
          class="step next"
          type="button"
          aria-label="Next screenshot"
          data-step="1"
        >
          ›
        </button>
        <div class="dots">
          {project.screenshots.map((_, index) => (
            <button
              type="button"
              aria-label={`Show screenshot ${index + 1} of ${count}`}
              aria-pressed={index === 0 ? "true" : "false"}
            />
          ))}
        </div>
      </>
    )}
  </div>
) : (
  <div class="visual" aria-hidden="true">
    <div class="sweep" />
    <span class="feed">
      [ {project.id.toUpperCase()} · AWAITING VISUAL FEED ]
    </span>
  </div>
)}

<style>
  .visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid rgb(157 255 90 / 30%);
    background-color: #060805;
    background-image:
      linear-gradient(rgb(157 255 90 / 12%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(157 255 90 / 12%) 1px, transparent 1px);
    background-size: 32px 32px;
    touch-action: pan-y;
  }

  /* Screenshots sit side by side; the track slides to the current one. */
  .track {
    position: absolute;
    inset: 0;
    display: flex;
    transform: translateX(calc(var(--slide, 0) * -100%));
    transition: transform 0.55s cubic-bezier(0.6, 0, 0.2, 1);
  }

  .shot {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    /* Whole screenshot, letterboxed on the grid whatever its shape. */
    object-fit: contain;
  }

  /* Faint scanlines keep screenshots in the HUD look. */
  .scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgb(7 8 6 / 18%) 0 1px,
      transparent 1px 3px
    );
    pointer-events: none;
  }

  .step {
    position: absolute;
    top: 50%;
    width: 36px;
    height: 48px;
    padding: 0;
    border: 1px solid rgb(157 255 90 / 35%);
    background: rgb(7 8 6 / 70%);
    color: var(--accent);
    font: inherit;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
    opacity: 0.75;
    transform: translateY(-50%);
    transition: opacity 0.15s ease;
  }

  .step:hover,
  .step:focus-visible {
    opacity: 1;
  }

  .step:focus-visible {
    outline-offset: -2px;
  }

  .prev {
    left: 8px;
  }

  .next {
    right: 8px;
  }

  .dots {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    gap: 6px;
  }

  /* 24px hit area around a small HUD tick. */
  .dots button {
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .dots button::before {
    content: "";
    display: block;
    width: 14px;
    height: 4px;
    margin: auto;
    background: rgb(157 255 90 / 35%);
    box-shadow: 0 0 0 1px rgb(7 8 6 / 70%);
  }

  .dots button[aria-pressed="true"]::before {
    background: var(--accent);
  }

  .dots button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .sweep {
    position: absolute;
    width: 140%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      rgb(157 255 90 / 35%),
      transparent 70deg,
      transparent 360deg
    );
    opacity: 0.6;
    animation: sweep 4s linear infinite;
  }

  @keyframes sweep {
    to {
      transform: rotate(360deg);
    }
  }

  .feed {
    position: relative;
    padding-inline: 12px;
    color: var(--text-dim);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      transition: none;
    }
  }
</style>
